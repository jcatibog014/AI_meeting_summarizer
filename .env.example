# Copy this file to .env (git ignores .env) and fill in your own values.
# Your Anthropic API key, from https://platform.claude.com (Settings > API keys).
# Without it, the app runs in practice mode: summaries are made-up samples, never a real Claude call.
ANTHROPIC_API_KEY=
# The most the whole site may spend on Claude in one day, in US cents (100 = $1).
DAILY_CAP_CENTS=100
# Real summaries each demo visitor may run in a day.
DEMO_RUNS_PER_DAY=3
